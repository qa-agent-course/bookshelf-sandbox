# Copy this file to .env (macOS/Linux: cp .env.example .env, Windows: Copy-Item .env.example .env)

# Server port
PORT=3000

# Network address the server listens on. Default 127.0.0.1 (this computer only).
# Never expose this app to a network: it is a training target with deliberate weaknesses.
# HOST=127.0.0.1

# Password of the two fake demo users (reader.one@example.com, reader.two@example.com).
# Tests read it from the environment. Never paste it into an agent chat.
DEMO_PASSWORD=change-me-locally

# Upper limit of the random delay (ms) added to some UI updates and API responses.
# 0 makes the app deterministic.
SANDBOX_JITTER_MS=800

# Set to 1 to run the "fixed build" (used to confirm that a reported problem is fixed).
# SANDBOX_FIXED=1
